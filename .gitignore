# ============================================================================
#  DLL Injector - .gitignore
# ============================================================================

# ---- Build output (build.bat / dotnet publish / CI) ----
/out/
/dist/
[Dd]ebug/
[Rr]elease/
[Dd]ebugPublic/
[Rr]eleasePublic/
build/
bld/

# ---- .NET build intermediates ----
DllInjector/bin/
DllInjector/obj/
**/bin/
**/obj/
project.lock.json
project.fragment.lock.json
artifacts/
*.tlog
*.log
*.pdb
*.mdb
*.cache

# ---- Visual Studio / Rider / VS Code ----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates
*.userosscache
*.sln.iml

# ---- Published binaries kept at the repository root ----
# Release downloads are attached to GitHub Releases, not committed.
/DllInjector-x64.exe
/DllInjector-x86.exe

# ---- Runtime artifacts produced when the injector runs ----
# (config / window position memory, manual-map base address records, logs)
inject_log.txt
hook_call_log.txt
DllInjector.config
DllInjector.mmmap
.dlInjector_wtest
.dllinjector_wtest

# ---- Test assets ----
# test_output/ holds locally compiled test targets and DLLs plus the marker
# files written by them at runtime; it is fully regenerated by test/build_test.bat
test_output/

# MSVC intermediate files for the test material.
# NOTE: the *compiled* test DLLs (test/TestHookDll/*.dll,
# test/TestReflectiveDll/TestReflectiveDll-*.dll) are intentionally shipped with
# the repository, so they are deliberately NOT ignored here.
#
# The validator executables next to them are NOT shipped: TestLoader-*.exe is
# rebuilt by test\TestReflectiveDll\build.bat on every run, and nothing consumes
# the committed copy (CI builds it, local runs build it). Committing them would
# only add a fresh binary diff to every build.
test/**/*.obj
test/**/*.exp
test/**/*.lib
test/**/*.ilk
test/**/*.res
test/**/*.idb
test/**/*.pdb
test/**/*.tlog
test/TestReflectiveDll/TestLoader-*.exe

# Same intermediates when a build is invoked from the repository root.
# cl.exe writes .obj/.exp/.lib into the *current working directory*, not next to
# the source file, so running "cl ... test\TextHookDll\TextHookDll.c" from the
# repo root drops them here and the test/** rules above do not cover them.
# (Every build script now does "cd /d "%SRC%"" for exactly this reason, which is
# also what used to make the link step fail with LNK1181 when run from the root.)
/*.obj
/*.exp
/*.lib
/*.ilk
/*.res
/*.idb
/*.tlog

# ---- Python (tools/git-api-sync.py, test/ManualMap/gen_shellcode.py) ----
__pycache__/
*.pyc

# ---- OS junk ----
Thumbs.db
ehthumbs.db
Desktop.ini$RECYCLE.BIN/
*.lnk
.DS_Store
