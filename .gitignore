# ============================================================================
#  DLL Injector - .gitignore
# ============================================================================

# ---- Build output (build.bat / dotnet publish / CI) ----
/out/
/dist/
[Dd]ebug/
[Rr]elease/
[Dd]ebugPublic/
[Rr]eleasePublic/
build/
bld/

# ---- .NET build intermediates ----
DllInjector/bin/
DllInjector/obj/
**/bin/
**/obj/
project.lock.json
project.fragment.lock.json
artifacts/
*.tlog
*.log
*.pdb
*.mdb
*.cache

# ---- Visual Studio / Rider / VS Code ----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates
*.userosscache
*.sln.iml

# ---- Published binaries kept at the repository root ----
# Release downloads are attached to GitHub Releases, not committed.
/DllInjector-x64.exe
/DllInjector-x86.exe

# ---- Runtime artifacts produced when the injector runs ----
# (config / window position memory, manual-map base address records, logs)
inject_log.txt
hook_call_log.txt
DllInjector.config
DllInjector.mmmap
.dlInjector_wtest
.dllinjector_wtest

# ---- Test assets ----
# test_output/ holds locally compiled test targets and DLLs plus the marker
# files written by them at runtime; it is fully regenerated by test/build_test.bat
test_output/

# MSVC intermediate files for the test material.
# NOTE: the *compiled* test binaries (test/TestHookDll/*.dll,
# test/TestReflectiveDll/*.dll, test/TestReflectiveDll/TestLoader-*.exe) are
# intentionally shipped with the repository, so they are deliberately NOT
# ignored here.
test/**/*.obj
test/**/*.exp
test/**/*.lib
test/**/*.ilk
test/**/*.res
test/**/*.idb
test/**/*.pdb
test/**/*.tlog

# ---- OS junk ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
